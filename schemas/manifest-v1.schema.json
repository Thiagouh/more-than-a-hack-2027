{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ball-events/manifest-v1.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "timeline": {
      "enum": [
        "tactical",
        "synthetic",
        "external"
      ]
    },
    "n_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fps": {
      "type": "number",
      "maximum": 1e+100,
      "minimum": 1e-100
    },
    "coordinates": {
      "const": "metres_corner_fixed"
    },
    "pitch_m": {
      "type": "array",
      "items": {
        "type": "number",
        "maximum": 1e+100,
        "minimum": 1e-100
      },
      "minItems": 2,
      "maxItems": 2
    },
    "teams": {
      "type": "object",
      "properties": {
        "H": {
          "type": "string",
          "pattern": "\\S"
        },
        "A": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "A",
        "H"
      ],
      "additionalProperties": false
    },
    "producers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?!.*:).*\\S.*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "continuity_starts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "properties": {
        "players": {
          "type": "string",
          "pattern": "\\S"
        },
        "ball": {
          "type": "string",
          "pattern": "\\S"
        },
        "hints": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "ball",
        "players"
      ],
      "additionalProperties": false
    },
    "is_clip": {
      "type": "boolean"
    },
    "origin": {
      "type": "object",
      "properties": {
        "timeline": {
          "type": "string",
          "pattern": "\\S"
        },
        "first_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "number",
          "maximum": 1e+100,
          "minimum": 1e-100
        }
      },
      "required": [
        "first_frame",
        "fps",
        "timeline"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "coordinates",
    "dataset_id",
    "fps",
    "n_frames",
    "pitch_m",
    "producers",
    "teams",
    "timeline"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "is_clip": {
            "const": true
          }
        },
        "required": [
          "is_clip"
        ]
      },
      "then": {
        "required": [
          "origin"
        ]
      }
    }
  ]
}
